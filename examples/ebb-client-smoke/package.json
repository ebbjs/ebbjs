{
  "name": "ebb-client-smoke",
  "version": "0.0.1",
  "private": true,
  "description": "End-to-end smoke test for @ebbjs/client connecting to a running ebb_server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/client": "workspace:*",
    "@ebbjs/core": "workspace:*",
    "@ebbjs/server": "workspace:*",
    "@ebbjs/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.20.4",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
