---
const sections = [
  {
    label: 'Current state',
    links: [
      { label: 'What is shipped', href: '/docs/' },
    ],
  },
  {
    label: 'v1 target API (planned)',
    links: [
      { label: 'Overview', href: '/docs/v1-target/overview' },
      { label: 'Getting started', href: '/docs/v1-target/getting-started' },
    ],
  },
  {
    label: 'v1 target — Core concepts',
    links: [
      { label: 'The data model', href: '/docs/v1-target/data-model' },
      { label: 'Relationships', href: '/docs/v1-target/relationships' },
      { label: 'Groups, membership & actors', href: '/docs/v1-target/groups' },
    ],
  },
  {
    label: 'v1 target — Architecture',
    links: [
      { label: 'Hybrid logical clocks', href: '/docs/v1-target/clock' },
      { label: 'Sync protocol', href: '/docs/v1-target/sync' },
      { label: 'Permission enforcement', href: '/docs/v1-target/permissions' },
      { label: 'Conflict resolution', href: '/docs/v1-target/conflicts' },
    ],
  },
  {
    label: 'v1 target — Guides',
    links: [
      { label: 'The client', href: '/docs/v1-target/client' },
      { label: 'Garbage collection', href: '/docs/v1-target/garbage-collection' },
      { label: 'Schema evolution', href: '/docs/v1-target/schema-evolution' },
      { label: 'Observability & analytics', href: '/docs/v1-target/observability' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<nav class="space-y-5">
  {sections.map((section) => (
    <div>
      <h2 class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-3">{section.label}</h2>
      <div class="space-y-1">
        {section.links.map((link) => {
          const isActive = currentPath === link.href || currentPath === `${link.href}/`;
          return (
            <a
              href={link.href}
              class:list={[
                'block py-1.5 text-sm transition-colors border-b-2',
                isActive
                  ? 'text-stone-100 font-semibold border-stone-100'
                  : 'text-stone-400 hover:text-stone-200 border-transparent hover:border-stone-700'
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </div>
  ))}
</nav>