---
const sections = [
  {
    label: 'Current state',
    links: [
      { label: 'What is shipped', href: '/docs/' },
    ],
  },
  {
    label: 'Planned (tracked on GitHub)',
    links: [
      { label: 'v1 API surface — Epic', href: 'https://github.com/ebbjs/ebbjs/issues/115', external: true },
      { label: 'Server functions — Epic', href: 'https://github.com/ebbjs/ebbjs/issues/112', external: true },
      { label: 'Peer replication — Epic', href: 'https://github.com/ebbjs/ebbjs/issues/113', external: true },
      { label: 'Server-side SDK — Epic', href: 'https://github.com/ebbjs/ebbjs/issues/114', external: true },
      { label: 'Collaborative text — Epic', href: 'https://github.com/ebbjs/ebbjs/issues/110', external: true },
      { label: 'Storage architecture (historical)', href: 'https://github.com/ebbjs/ebbjs/issues/111', external: true },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<nav class="space-y-5">
  {sections.map((section) => (
    <div>
      <h2 class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-3">{section.label}</h2>
      <div class="space-y-1">
        {section.links.map((link) => {
          const isActive = !link.external && (currentPath === link.href || currentPath === `${link.href}/`);
          return (
            <a
              href={link.href}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class:list={[
                'block py-1.5 text-sm transition-colors border-b-2',
                isActive
                  ? 'text-stone-100 font-semibold border-stone-100'
                  : 'text-stone-400 hover:text-stone-200 border-transparent hover:border-stone-700'
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </div>
    </div>
  ))}
</nav>