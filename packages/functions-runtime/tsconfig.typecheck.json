{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "composite": false,
    "paths": {
      "@ebbjs/client": ["../client/src/index.ts"],
      "@ebbjs/core": ["../core/src/index.ts"],
      "@ebbjs/core/*": ["../core/src/*/index.ts"],
      "@ebbjs/schema": ["../schema/src/index.ts"],
      "@ebbjs/write": ["../write/src/index.ts"],
      "@ebbjs/storage": ["../storage/src/index.ts"],
      "@ebbjs/storage/*": ["../storage/src/*/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
