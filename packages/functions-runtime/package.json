{
  "name": "@ebbjs/functions-runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Function context and host transport for the ebb functions runner",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/client": "workspace:^",
    "@ebbjs/core": "workspace:^",
    "@ebbjs/functions-protocol": "workspace:*",
    "@ebbjs/schema": "workspace:^",
    "@ebbjs/write": "workspace:^"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^25.2.3",
    "vitest": "^4.1.0"
  }
}
