{
  "name": "@ebbjs/storage",
  "version": "0.1.0",
  "private": false,
  "description": "Storage components for ebbjs",
  "homepage": "https://ebbjs.com",
  "bugs": {
    "url": "https://github.com/ebbjs/ebbjs/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebbjs/ebbjs.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb/index.d.ts",
      "import": "./dist/indexeddb/index.js"
    },
    "./replica": {
      "types": "./dist/replica/index.d.ts",
      "import": "./dist/replica/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "benchmark": "tsx src/benchmark/run.ts",
    "benchmark:map-field": "tsx src/benchmark/map-field.ts",
    "bundle-check": "tsx scripts/bundle-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@ebbjs/core": "workspace:^"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "idb": "^8.0.3",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "idb": "^8.0.3"
  },
  "peerDependenciesMeta": {
    "idb": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
