{
  "name": "@ebbjs/storage",
  "version": "0.0.1",
  "private": true,
  "description": "Storage components for ebbjs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "benchmark": "tsx src/benchmark/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/core": "workspace:*",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}
