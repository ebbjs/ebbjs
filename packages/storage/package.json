{
  "name": "@ebbjs/storage",
  "version": "0.0.1",
  "private": true,
  "description": "Storage components for ebbjs",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./indexeddb": {
      "types": "./dist/indexeddb/index.d.ts",
      "import": "./dist/indexeddb/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "benchmark": "tsx src/benchmark/run.ts",
    "bundle-check": "tsx scripts/bundle-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/core": "workspace:*"
  },
  "peerDependencies": {
    "idb": "^8.0.3"
  },
  "peerDependenciesMeta": {
    "idb": {
      "optional": true
    }
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^15.11.7",
    "idb": "^8.0.3",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}
