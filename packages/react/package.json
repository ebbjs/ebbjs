{
  "name": "@ebbjs/react",
  "version": "0.0.1",
  "private": true,
  "description": "React bindings for @ebbjs/client — provider, connection hook, and the plumbing later data hooks build on.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/client": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "happy-dom": "^17.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
