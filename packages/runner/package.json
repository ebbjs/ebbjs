{
  "name": "@ebbjs/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Bun process that runs one ebb function invocation",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/functions-protocol": "workspace:*",
    "@ebbjs/functions-runtime": "workspace:*",
    "@ebbjs/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "vitest": "^4.1.0"
  }
}
