{
  "name": "@ebbjs/client",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run --exclude '**/__tests__/integration/**'",
    "test:watch": "vitest --exclude '**/__tests__/integration/**'",
    "test:integration": "vitest --run src/__tests__/integration",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/core": "workspace:*",
    "@ebbjs/storage": "workspace:*",
    "@sinclair/typebox": "latest",
    "eventsource-client": "^1.2.0"
  },
  "devDependencies": {
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}
