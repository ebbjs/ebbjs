{
  "name": "@ebbjs/client",
  "version": "0.1.0",
  "private": false,
  "description": "Local-first sync client for ebbjs: handshake, live sync, typed query engine, write verbs, presence, and collaborative text.",
  "homepage": "https://ebbjs.com",
  "bugs": {
    "url": "https://github.com/ebbjs/ebbjs/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebbjs/ebbjs.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "benchmark": "NODE_OPTIONS=--expose-gc tsx src/benchmark/replica-read-model.ts",
    "benchmark:map-read": "tsx src/benchmark/map-read.ts",
    "dev": "vite build --watch",
    "test": "vitest --run --exclude '**/__tests__/integration/**'",
    "test:watch": "vitest --exclude '**/__tests__/integration/**'",
    "test:integration": "vitest --run src/__tests__/integration",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@ebbjs/core": "workspace:^",
    "@ebbjs/storage": "workspace:^",
    "@sinclair/typebox": "^0.34.52",
    "eventsource-client": "^1.2.0"
  },
  "devDependencies": {
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
