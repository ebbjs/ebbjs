{
  "name": "@ebbjs/collaborative-text-editor",
  "version": "0.0.1",
  "private": true,
  "description": "CodeMirror 6 bridge for @ebbjs/client's TextDocument — bidirectional sync between the causal-tree field and a CM6 editor view.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/client": "workspace:*"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.30.0",
    "codemirror": "^6.0.0"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@ebbjs/core": "workspace:*",
    "codemirror": "^6.0.1",
    "happy-dom": "^17.4.4",
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  }
}