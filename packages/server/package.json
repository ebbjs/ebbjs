{
  "name": "@ebbjs/server",
  "version": "0.0.0",
  "private": true,
  "description": "Function authoring SDK for ebbjs: defineFunction, FunctionSchema, and the p schema builder",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest --run",
    "test:types": "vitest --run --typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check"
  },
  "dependencies": {
    "@ebbjs/client": "workspace:^",
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "vitest": "^4.1.0"
  }
}
