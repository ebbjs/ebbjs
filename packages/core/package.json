{
  "name": "@ebbjs/core",
  "version": "0.3.0",
  "private": false,
  "description": "TypeScript foundation for ebbjs: shared types, HLC, MessagePack wire codec, action creation, and ID generation.",
  "homepage": "https://ebbjs.com",
  "bugs": {
    "url": "https://github.com/ebbjs/ebbjs/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebbjs/ebbjs.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm --root ../../ lint",
    "lint:fix": "pnpm --root ../../ lint:fix",
    "fmt": "pnpm --root ../../ fmt",
    "fmt:check": "pnpm --root ../../ fmt:check",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@sinclair/typebox": "^0.34.52",
    "nanoid": "^5.1.7"
  },
  "devDependencies": {
    "tsx": "^4.20.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
